# --- Local model backend ---
LLM_PROVIDER=ollama            # ollama | openai (LM Studio, llama.cpp server, vLLM, ...)
LLM_MODEL=llama3.2             # a tool-capable model works best (llama3.1+, qwen2.5, mistral-nemo)
OLLAMA_URL=http://localhost:11434
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=
TOOL_MODE=auto                 # auto | native | text (text = JSON-in-prompt for models without tool calling)

# --- Server ---
PORT=3000
# CONSTR=mongodb://...         # optional; rooms are kept in memory without it

# --- Tools ---
EXEC_ENABLED=true              # set false to disable code execution
WEB_ENABLED=true
SEARX_URL=                     # self-hosted SearXNG, otherwise DuckDuckGo
WEB_ALLOW_PRIVATE=false

# --- Self-evolution ---
SELF_EVOLVE=true
EVOLVE_MAX_EDITS_PER_HOUR=20
